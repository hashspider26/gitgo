    "CLOUDINARY_CLOUD_NAME": "dglf8tzbw",
    "CLOUDINARY_API_KEY": "122184543887739",
    "NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME": "dglf8tzbw",
    "NEXTAUTH_URL": "https://greenvalleyseeds.pk",
    "NEXT_PUBLIC_GA_ID": "G-P9102JKHC8",
    "NEXT_PUBLIC_META_PIXEL_ID": "2740536566288654"
  }
}